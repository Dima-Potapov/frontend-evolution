# Скопируй этот файл в .env и заполни своими данными. .env НЕ коммитим!

# --- База данных (как в v08, но отдельная БД) ---
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/frontend_evolution_v09"

# --- Auth.js ---
# Секрет для подписи/шифрования cookie сессии. Сгенерировать:
#   npx auth secret        или        openssl rand -base64 32
AUTH_SECRET=""

# Доверять заголовку Host (нужно при запуске не на localhost: прокси, превью, Docker)
AUTH_TRUST_HOST=true

# --- Вход через Google (необязательно) ---
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Если оставить пустыми — кнопки Google просто не будет.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Демо-вход «по имени» без пароля (только для учёбы!) ---
# true — на странице входа появится форма «Ваше имя». В продакшене — false.
AUTH_DEMO_LOGIN=true
